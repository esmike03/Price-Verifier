<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/manual_product_hint"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/manualBarcodeInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/input_field"
            android:hint="@string/manual_product_barcode"
            android:importantForAutofill="no"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted" />

        <EditText
            android:id="@+id/manualNameInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_field"
            android:hint="@string/manual_product_name"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted" />

        <EditText
            android:id="@+id/manualUomInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_field"
            android:hint="@string/manual_product_uom"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted" />

        <EditText
            android:id="@+id/manualCategoryInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_field"
            android:hint="@string/manual_product_category"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted" />

        <EditText
            android:id="@+id/manualPriceInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_field"
            android:hint="@string/manual_product_price"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted" />

        <EditText
            android:id="@+id/manualItemCodeInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_field"
            android:hint="@string/manual_product_item_code"
            android:importantForAutofill="no"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted" />

        <Button
            android:id="@+id/saveManualProductButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/button_primary"
            android:fontFamily="sans-serif-medium"
            android:text="@string/manual_product_save"
            android:textAllCaps="false"
            android:textColor="@color/surface"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
