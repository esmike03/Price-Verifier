<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <Spinner
            android:id="@+id/promoLabelSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_field" />

        <Spinner
            android:id="@+id/promoTypeSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_field" />

        <EditText
            android:id="@+id/promoValue"
            style="@style/AdminEditField"
            android:inputType="numberDecimal" />

        <!-- Shown only for Buy X Take Y. -->
        <LinearLayout
            android:id="@+id/promoBuyTakeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <EditText
                android:id="@+id/promoBuy"
                style="@style/AdminEditField"
                android:layout_width="0dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:hint="@string/promo_buy_hint"
                android:inputType="number" />

            <EditText
                android:id="@+id/promoTake"
                style="@style/AdminEditField"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="@string/promo_take_hint"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/promoStartButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/promoEndButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAllCaps="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/promoPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/ink"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/promoServerNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/promo_server_note"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
