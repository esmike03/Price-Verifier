<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingVertical="8dp">

        <!-- Shown when the portal's Design tab manages any of these settings. -->
        <TextView
            android:id="@+id/designServerNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/design_note"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:text="@string/design_server_note"
            android:textColor="@color/accent_dark"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Sized for the largest allowed logo scale; the preview inside is
                 resized in code so it mirrors the slider setting. -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/logo_frame">

                <ImageView
                    android:id="@+id/logoPreview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/idle_logo_label"
                    android:maxHeight="40dp"
                    android:maxWidth="40dp"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/idle_logo_label"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/logoStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/idle_no_logo"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/uploadLogoButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/button_secondary"
                        android:fontFamily="sans-serif-medium"
                        android:minWidth="0dp"
                        android:paddingHorizontal="14dp"
                        android:text="@string/idle_upload_logo"
                        android:textAllCaps="false"
                        android:textColor="@color/ink"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/removeLogoButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/button_secondary"
                        android:fontFamily="sans-serif-medium"
                        android:minWidth="0dp"
                        android:paddingHorizontal="14dp"
                        android:text="@string/idle_remove"
                        android:textAllCaps="false"
                        android:textColor="@color/accent_dark"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="@string/idle_logo_size_label"
                        android:textColor="@color/ink"
                        android:textSize="13sp" />

                    <SeekBar
                        android:id="@+id/logoScaleSlider"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/logoScaleValue"
                        android:layout_width="52dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="end"
                        android:textColor="@color/ink"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="2dp"
            android:text="@string/idle_media_format_help"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/idle_banner_label"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/bannerStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/idle_no_banner"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/banner_frame">

                <ImageView
                    android:id="@+id/bannerPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/idle_banner_label"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/uploadBannerButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/button_secondary"
                    android:fontFamily="sans-serif-medium"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:text="@string/idle_upload_banner"
                    android:textAllCaps="false"
                    android:textColor="@color/ink"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/removeBannerButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/button_secondary"
                    android:fontFamily="sans-serif-medium"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:text="@string/idle_remove"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_dark"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:text="@string/idle_image_seconds_label"
                    android:textColor="@color/ink"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/imageSecondsInput"
                    android:layout_width="80dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/input_field"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="3"
                    android:singleLine="true"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/muted" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/idle_video_label"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/videoStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/idle_no_video"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/uploadVideoButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/button_secondary"
                    android:fontFamily="sans-serif-medium"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:text="@string/idle_upload_video"
                    android:textAllCaps="false"
                    android:textColor="@color/ink"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/removeVideoButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/button_secondary"
                    android:fontFamily="sans-serif-medium"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:text="@string/idle_remove"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_dark"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:text="@string/idle_video_seconds_label"
                    android:textColor="@color/ink"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/videoSecondsInput"
                    android:layout_width="80dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/input_field"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="5"
                    android:singleLine="true"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/muted" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/idle_store_name_label"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/storeNameInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_field"
                android:fontFamily="sans-serif"
                android:hint="@string/idle_store_name_hint"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textColorHint="@color/muted"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/videoLogoToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="@color/brand"
                android:fontFamily="sans-serif"
                android:text="@string/idle_video_logo_label"
                android:textColor="@color/ink"
                android:textSize="14sp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:background="@color/muted" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/idle_order_label"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/mediaOrderStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/idle_order_following_server"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/mediaOrderList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/applyOrderButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans-serif-medium"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/idle_order_apply"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <Button
                android:id="@+id/useServerOrderButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans-serif-medium"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/idle_order_use_server"
                android:textAllCaps="false"
                android:textColor="@color/accent_dark"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/idle_marquee_label"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/marqueeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/input_field"
            android:fontFamily="sans-serif"
            android:hint="@string/idle_marquee_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="3"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/marqueeBgColorInput"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/input_field"
                android:fontFamily="sans-serif"
                android:hint="@string/idle_marquee_bg_color"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="7"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textColorHint="@color/muted"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/marqueeTextColorInput"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/input_field"
                android:fontFamily="sans-serif"
                android:hint="@string/idle_marquee_text_color"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="7"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textColorHint="@color/muted"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/pickMarqueeBgColorButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans-serif-medium"
                android:text="@string/pick_background_color"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <Button
                android:id="@+id/pickMarqueeTextColorButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans-serif-medium"
                android:text="@string/pick_text_color"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/idle_scan_prompt_label"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/scanPromptColorInput"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/input_field"
                android:fontFamily="sans-serif"
                android:hint="@string/idle_scan_prompt_hint"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="7"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textColorHint="@color/muted"
                android:textSize="15sp" />

            <Button
                android:id="@+id/pickScanPromptColorButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/button_secondary"
                android:fontFamily="sans-serif-medium"
                android:minWidth="0dp"
                android:paddingHorizontal="18dp"
                android:text="@string/pick_color"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/updateIdleDisplayButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/button_primary"
            android:fontFamily="sans-serif-medium"
            android:text="@string/idle_update_display"
            android:textAllCaps="false"
            android:textColor="@color/surface"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
