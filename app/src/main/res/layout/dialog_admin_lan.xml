<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/lan_hint"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/lanUrlInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/input_field"
            android:fontFamily="sans-serif"
            android:hint="@string/lan_url_hint"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:textSize="15sp" />

        <Button
            android:id="@+id/saveLanUrlButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/button_secondary"
            android:fontFamily="sans-serif-medium"
            android:text="@string/lan_save_url"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/lan_manual_sync_label"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/manualSyncButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/syncItemsButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/button_primary"
                android:fontFamily="sans-serif-medium"
                android:text="@string/lan_sync_items"
                android:textAllCaps="false"
                android:textColor="@color/surface"
                android:textSize="13sp" />

            <Button
                android:id="@+id/syncImagesButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/button_primary"
                android:fontFamily="sans-serif-medium"
                android:text="@string/lan_sync_images"
                android:textAllCaps="false"
                android:textColor="@color/surface"
                android:textSize="13sp" />

            <Button
                android:id="@+id/syncVideosButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/button_primary"
                android:fontFamily="sans-serif-medium"
                android:text="@string/lan_sync_videos"
                android:textAllCaps="false"
                android:textColor="@color/surface"
                android:textSize="13sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/lanSyncProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/brand"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lanStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingMultiplier="1.25"
            android:textColor="@color/muted"
            android:textSize="13sp"
            tools:text="Last sync: 2026-05-29 14:23" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/autoSyncToggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/brand"
                android:fontFamily="sans-serif-medium"
                android:text="@string/lan_auto_sync"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <Button
                android:id="@+id/autoSyncTimeButton"
                android:layout_width="100dp"
                android:layout_height="44dp"
                android:background="@drawable/input_field"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:text="@string/lan_default_time"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/autoSyncHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/muted"
            android:textSize="12sp"
            tools:text="Sync all content once daily at 02:00." />
    </LinearLayout>
</ScrollView>
