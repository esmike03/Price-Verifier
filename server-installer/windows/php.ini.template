; Price Verifier server PHP settings (Windows). Generated by install.ps1.
[PHP]
engine = On
short_open_tag = Off
expose_php = Off
memory_limit = 256M
max_execution_time = 180
max_input_time = 180
file_uploads = On
upload_max_filesize = 128M
post_max_size = 132M
max_file_uploads = 50
display_errors = Off
display_startup_errors = Off
log_errors = On
error_log = "{{LOGS}}\php-errors.log"
user_ini.filename = ".user.ini"

extension_dir = "{{PHP}}\ext"
extension = gd
extension = mbstring
extension = fileinfo
extension = openssl
; Reads Excel (.xlsx) catalog uploads.
extension = zip
; Data source tab: reads the catalog from the store's POS database. ODBC covers
; SQL Server, SAP HANA, Db2, Access and any database with an ODBC driver.
extension = pdo_mysql
extension = pdo_pgsql
extension = pdo_sqlite
extension = pdo_odbc
; Firebird and Oracle client libraries, added by the installer when found on this PC.
{{OPTIONAL_EXTENSIONS}}
; OPcache stays off. Each PHP worker is a separately started php-cgi process, and
; on Windows they must all map OPcache's shared memory at the same address. When
; one cannot (it depends on the PC, and antivirus software makes it more likely)
; that worker dies with "Unable to reattach to base address", and requests that
; reach it fail with HTTP 502. The portal is one small script, so it is not missed.
opcache.enable = 0

; Required for php-cgi behind a FastCGI web server.
cgi.force_redirect = 0
cgi.fix_pathinfo = 1
fastcgi.impersonate = 0

[Date]
date.timezone = {{TIMEZONE}}

[Session]
session.save_path = "{{SESSIONS}}"
session.use_strict_mode = 1
session.gc_maxlifetime = 28800
