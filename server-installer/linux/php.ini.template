; Price Verifier server PHP settings (Linux). Generated by install.sh.
; Loaded by FrankenPHP through PHP_INI_SCAN_DIR (see the systemd unit).
expose_php = Off
memory_limit = 256M
max_execution_time = 180
max_input_time = 180
file_uploads = On
upload_max_filesize = 128M
post_max_size = 132M
max_file_uploads = 50
display_errors = Off
log_errors = On
error_log = {{LOGS}}/php-errors.log
date.timezone = {{TIMEZONE}}
session.save_path = {{SESSIONS}}
session.use_strict_mode = 1
session.gc_maxlifetime = 28800
